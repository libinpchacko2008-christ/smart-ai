# Obtain this at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Generate a random 32+ character value. Render will generate one automatically.
APP_SECRET=replace_with_long_random_secret
APP_ENV=development
# Optional, e.g. /var/data/studymate.db on a persistent disk
# DATABASE_PATH=./studymate.db
